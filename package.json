{
  "name": "elea-notes",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "gate:terms": "python3 scripts/check_terms.py",
    "gate:quotes": "python3 scripts/check_quotes.py",
    "gate:wiki": "python3 scripts/check_wiki.py",
    "gate:titles": "python3 scripts/lint_titles.py",
    "gate:links": "python3 scripts/check_links.py",
    "gate:layout": "python3 scripts/check_layout.py",
    "gate:ladder": "python3 scripts/check_ladder.py",
    "gate:render": "python3 scripts/check_render.py",
    "gate": "npm run check && npm run gate:terms && npm run gate:quotes && npm run gate:wiki && npm run gate:titles && npm run build && npm run gate:links && npm run gate:layout && npm run gate:ladder && npm run gate:render",
    "test": "npm run gate",
    "gate:live": "python3 scripts/check_live.py",
    "verify": "npm run gate && npm run gate:live",
    "diagnose": "python3 scripts/diagnose_access.py"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "astro": "7.1.6",
    "katex": "^0.18.1",
    "marked": "18.0.7",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "typescript": "^5.9.3"
  }
}
