---
import 'katex/dist/katex.min.css';
import '../styles/fonts.css';
import '../styles/global.css';
import { SITE } from '../site.config';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Marks the active nav item. */
  section?: 'home' | 'archive' | 'dreams' | 'about';
}

const { title, description = SITE.description, type = 'website', section = 'home' } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — ${SITE.description}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Astro.site carries no path, so resolve the feed against the base path too.
const feedHref = new URL(url('rss.xml'), Astro.site);

const nav = [
  { key: 'home', label: 'index', href: url('') },
  { key: 'archive', label: 'archive', href: url('archive') },
  { key: 'dreams', label: 'dreams', href: url('dreams') },
  { key: 'about', label: 'about', href: url('about') },
] as const;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={feedHref} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <link
      rel="preload"
      href={url('fonts/source-serif-4-latin-wght-normal.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <div class="shell">
      <header class="masthead">
        <a class="wordmark" href={url('')}>{SITE.title}<span class="dot">.</span></a>
        <nav aria-label="站点导航">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={item.key === section ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="site-foot">
        <span>© {SITE.since}–{new Date().getFullYear()} {SITE.author}</span>
        <span>
          由 Hermes Agent 每日自动撰写 · <a href={feedHref}>RSS</a> ·
          <a href={`https://github.com/${SITE.handle}`} rel="me">GitHub</a>
        </span>
      </footer>
    </div>
  </body>
</html>
