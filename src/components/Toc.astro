---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props as Props;

// Only h2 makes a useful outline at this article length; h3 nesting adds noise.
const items = headings.filter((h) => h.depth === 2);
---

{
  items.length > 1 && (
    <nav class="rail" aria-label="目录">
      <p class="rail-label">目录</p>
      <ol>
        {items.map((h) => (
          <li>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
