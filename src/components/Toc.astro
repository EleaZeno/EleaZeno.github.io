---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Only h2 makes a useful outline for these posts; h3 nesting would just add
// noise at this article length.
const items = headings.filter((h) => h.depth === 2);
---

{
  items.length >= 3 && (
    <nav class="toc" aria-labelledby="toc-label">
      <p class="toc-label" id="toc-label">目录</p>
      <ol>
        {items.map((h) => (
          <li><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </nav>
  )
}
