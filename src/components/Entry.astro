---
import { formatDate, DOMAIN_LABELS, type Post } from '../lib/posts';
import { postUrl, tagUrl } from '../lib/url';

interface Props {
  post: Post;
  /** Running index shown in the left rail. */
  index?: number;
  as?: 'h2' | 'h3';
}

const { post, index, as = 'h2' } = Astro.props as Props;
const Title = as;
---

<article class="entry">
  <div class="entry-meta">
    {index !== undefined && <span class="num">{String(index).padStart(3, '0')}</span>}
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    <span>{DOMAIN_LABELS[post.data.domain] ?? post.data.domain}</span>
  </div>
  <div>
    <Title><a href={postUrl(post.id)}>{post.data.title}</a></Title>
    <p>{post.data.description}</p>
    {
      post.data.tags.length > 0 && (
        <ul class="tags">
          {post.data.tags.map((t: string) => (
            <li>
              <a class="tag" href={tagUrl(t)}>{t}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
