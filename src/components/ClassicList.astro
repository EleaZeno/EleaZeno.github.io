---
/*
 * A compact list of deconstructions, for pages whose main body is a post feed
 * (tag pages, domain pages).
 *
 * Not Entry.astro: that renders post-shaped metadata (tags, reading time). A
 * classic carries an original title and year instead, so routing it through
 * Entry would mean widening that component's contract for two call sites.
 */
import type { Classic } from '../lib/classics';
import { url } from '../lib/url';

interface Props {
  items: Classic[];
  heading?: string;
}

const { items, heading = '相关的一手文献拆解' } = Astro.props as Props;
---

{
  items.length > 0 && (
    <section class="classic-aside">
      <p class="kicker">{heading}</p>
      <ul class="classic-list">
        {items.map(({ id, data }) => (
          <li>
            <a href={url(`classics/${id}`)}>{data.title}</a>
            <span class="muted mono"> {data.originalYear}</span>
            <p class="muted" style="margin:0.2rem 0 0; font-size:0.85rem">{data.originalTitle}</p>
          </li>
        ))}
      </ul>
    </section>
  )
}
