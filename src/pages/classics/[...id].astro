---
import type { InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import { marked } from 'marked';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import Stamp from '../../components/Stamp.astro';
import { formatDate } from '../../lib/posts';
import { getClassics } from '../../lib/classics';
import { url, hostOf, tagUrl } from '../../lib/url';
import { hasSidenotes } from '../../lib/sidenotes';

export const getStaticPaths = async () => {
  const sorted = await getClassics();
  return sorted.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props as Props;
const { Content, headings } = await render(entry);
const marginNotes = hasSidenotes(entry.body);
const d = entry.data;

const takeHtml = d.take ? await marked.parse(d.take) : '';

// Resolve declared prerequisites against the wiki so the header can show which
// gaps we actually cover on-site and which are still external.
const concepts = await getCollection('concepts');
const byId = new Map(concepts.map((c) => [c.id, c]));
const prereqs = d.prerequisites.map((id: string) => {
  const c = byId.get(id);
  return {
    id,
    title: c?.data.title ?? id,
    oneLiner: c?.data.oneLiner ?? null,
    href: c ? url(`concepts/${id}`) : null,
  };
});
const covered = prereqs.filter((p) => p.href).length;

/*
 * Hard build constraint, not a soft warning.
 *
 * The goal for this section is that every prerequisite a classic assumes is
 * itself explained on-site in the same annotated form. A dangling prerequisite
 * silently degrades to plain text, which is exactly the failure that would
 * accumulate unnoticed, so a missing concept fails the build instead.
 */
const dangling = prereqs.filter((p) => !p.href).map((p) => p.id);
if (dangling.length > 0) {
  throw new Error(
    `classics/${entry.id}: prerequisites reference concepts that do not exist: ` +
      `${dangling.join(', ')}. Write src/content/concepts/<id>.md first, ` +
      `or drop the id from frontmatter.`,
  );
}

const LEVEL_LABELS: Record<string, string> = {
  intro: '入门',
  core: '进阶',
  deep: '深入',
};

/*
 * Further reading, grouped by how each item stands to the primary text.
 *
 * The order is the argument: what the text was built on, what answers the same
 * question differently, what it became, and finally what disputes it. Rendering
 * `counter` last and never hiding the bucket is deliberate -- a deconstruction
 * that only cites agreement is advocacy, so the absence of dissent should be
 * visible on the page rather than quietly absent from it.
 */
type ReadingItem = {
  title: string;
  author?: string;
  note: string;
  url?: string;
  level: string;
  relation: string;
  concepts: string[];
};

const RELATION_ORDER = ['upstream', 'parallel', 'downstream', 'counter'] as const;

const RELATION_LABELS: Record<string, { label: string; hint: string }> = {
  upstream: { label: '上游', hint: '这篇论文站在谁的肩膀上' },
  parallel: { label: '平行', hint: '同一个问题的另一种答卷' },
  downstream: { label: '下游', hint: '这个想法后来变成了什么' },
  counter: { label: '反面', hint: '质疑或限制原文结论的材料' },
};

const readingGroups = RELATION_ORDER.map((rel) => ({
  rel,
  ...RELATION_LABELS[rel],
  items: (d.reading as ReadingItem[]).filter((r) => r.relation === rel),
})).filter((g) => g.items.length > 0);

// Resolve inward links so further reading is a junction, not an exit.
const conceptLink = (id: string) => {
  const c = byId.get(id);
  return c ? { id, title: c.data.title, href: url(`concepts/${id}`) } : null;
};

const FIELD_LABELS: Record<string, string> = {
  crypto: '密码学与分布式',
  philosophy: '哲学',
  mathematics: '数学',
  physics: '物理',
  computing: '计算',
  economics: '经济',
  other: '其他',
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  ...(d.updatedDate ? { dateModified: d.updatedDate.toISOString() } : {}),
  author: { '@type': 'Organization', name: 'Elea Notes' },
  about: { '@type': 'CreativeWork', name: d.originalTitle, author: d.author },
  citation: [d.primary, ...d.sources].map((s: { title: string; url: string }) => ({
    '@type': 'CreativeWork',
    name: s.title,
    url: s.url,
  })),
};
---

<Base title={d.title} description={d.description} type="article" section="classics">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <!-- Reserve the margin only when the entry actually renders sidenotes. -->
  <div class:list={['layout', marginNotes && 'has-margin-notes']}>
    <article class="article">
      <header class="article-head">
        <p class="kicker">经典</p>
        <h1>{d.title}</h1>
        <p class="standfirst">{d.description}</p>
        <div class="byline">
          <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate)}</time>
          <span class="sep">/</span>
          <span>{FIELD_LABELS[d.field] ?? d.field}</span>
          <span class="sep">/</span>
          <span>{d.difficulty.minutes} 分钟</span>
          {d.generatedBy && (
            <>
              <span class="sep">/</span>
              <span>{d.generatedBy}</span>
            </>
          )}
        </div>

        <dl class="original">
          <div>
            <dt>原文</dt>
            <dd>
              <a href={d.primary.url} rel="nofollow noopener" target="_blank">{d.originalTitle}</a>
            </dd>
          </div>
          <div>
            <dt>作者</dt>
            <dd>{d.author}（{d.originalYear}）</dd>
          </div>
          {d.primaryChecksum && (
            <div>
              <dt>校验</dt>
              <dd class="mono checksum">{d.primaryChecksum}</dd>
              {d.primaryChecksumNote && (
                <dd class="checksum-note">{d.primaryChecksumNote}</dd>
              )}
            </div>
          )}
        </dl>

        {
          d.tags.length > 0 && (
            <ul class="tags tags-trail">
              {d.tags.map((t) => (
                <li>
                  <a class="tag" href={tagUrl(t)}>{t}</a>
                </li>
              ))}
            </ul>
          )
        }
      </header>

      <section class="gate">
        <h2 id="怎么读">怎么读这篇</h2>
        <p class="gate-line">
          这篇按<strong>原文分节</strong>走：每节先给一句话主旨，再逐段讲原文在说什么、
          为什么这么写。术语和公式的解释放在正文右侧的边注里，读到哪看到哪。
          每节末尾有一道自测题——答不出就说明那节没读懂，回头再看一遍比往下读划算。
        </p>
        <p class="gate-line">
          <strong>适合谁读：</strong>{d.difficulty.audience}
        </p>
        {/*
          Quoted primary text is left as unbroken, selectable English so any
          pop-up dictionary works on it. We deliberately do not ship our own
          word-level dictionary: general dictionaries are a solved commodity,
          while the site's own value is the term pages. Saying so here tells the
          reader where the boundary is instead of leaving them to discover it.
        */}
        <p class="gate-line gate-dict">
          <strong>英文原文怎么查词：</strong>引文块保持整段可选中，任何划词翻译工具都能直接用
          （iOS Safari 长按选词后选「查询」，桌面端可用沙拉查词一类扩展）。
          本站只解释<strong>术语</strong>——像 proof-of-work、Merkle root 这种通用词典给不出
          本文特定含义的词，会链到站内词条；普通生词交给你自己的词典更靠得住。
        </p>
        {d.difficulty.hardParts.length > 0 && (
          <div class="gate-hard">
            <p class="gate-sublabel">哪里真的难，不糊弄你</p>
            <ul>
              {d.difficulty.hardParts.map((h: string) => <li>{h}</li>)}
            </ul>
          </div>
        )}
        {prereqs.length > 0 && (
          <div class="gate-prereq">
            <p class="gate-sublabel">
              前置知识（{covered}/{prereqs.length} 条站内已有）
            </p>
            <ul>
              {prereqs.map((p) => (
                <li>
                  {p.href ? <a href={p.href}>{p.title}</a> : <span class="missing">{p.title}</span>}
                  {p.oneLiner && <span class="prereq-hint">{p.oneLiner}</span>}
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>

      <div class="prose classic-body">
        <Content />
      </div>

      {
        takeHtml && (
          <aside class="take">
            <p class="take-label">我的看法</p>
            <div class="prose" set:html={takeHtml} />
          </aside>
        )
      }

      {
        d.reading.length > 0 && (
          <section class="reading">
            <h2 id="继续读">继续读什么</h2>
            <p class="reading-intro">
              按与原文的关系分组，每组内由浅入深。每条都说明为什么值得读——书单不给理由就只是摆设。
            </p>
            {readingGroups.map((g) => (
              <div class="reading-group">
                <h3 class="reading-rel">
                  {g.label}
                  <span class="reading-rel-hint">{g.hint}</span>
                </h3>
                <ol>
                  {g.items.map((r) => (
                    <li>
                      <p class="reading-head">
                        {r.url ? (
                          <a href={r.url} rel="nofollow noopener" target="_blank">{r.title}</a>
                        ) : (
                          <span class="reading-title">{r.title}</span>
                        )}
                        {r.author && <span class="reading-author">{r.author}</span>}
                        <span class="mono lvl">{LEVEL_LABELS[r.level] ?? r.level}</span>
                      </p>
                      <p class="reading-note">{r.note}</p>
                      {r.concepts.length > 0 && (
                        <p class="reading-concepts">
                          <span class="reading-concepts-label">站内词条</span>
                          {r.concepts.map((id) => {
                            const c = conceptLink(id);
                            return c ? (
                              <a class="reading-concept" href={c.href}>{c.title}</a>
                            ) : (
                              <span class="reading-concept missing">{id}</span>
                            );
                          })}
                        </p>
                      )}
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </section>
        )
      }

      <section class="sources">
        <h2 id="来源">来源</h2>
        <ol>
          <li>
            <a href={d.primary.url} rel="nofollow noopener" target="_blank">{d.primary.title}</a>
            <span class="host">{d.primary.outlet ?? hostOf(d.primary.url)}</span>
          </li>
          {d.sources.map((s: { title: string; url: string; outlet?: string }) => (
            <li>
              <a href={s.url} rel="nofollow noopener" target="_blank">{s.title}</a>
              <span class="host">{s.outlet ?? hostOf(s.url)}</span>
            </li>
          ))}
        </ol>
      </section>
    </article>

    <div class="rail-stack">
      <Toc headings={headings} />
      <Stamp seed={entry.id} />
    </div>
  </div>
</Base>
