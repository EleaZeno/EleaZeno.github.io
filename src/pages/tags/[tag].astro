---
import type { InferGetStaticPropsType } from 'astro';
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import ClassicList from '../../components/ClassicList.astro';
import { getClassics } from '../../lib/classics';
import { getPublishedPosts, tagCounts } from '../../lib/posts';
import { tagSlug } from '../../lib/url';

export const getStaticPaths = async () => {
  const posts = await getPublishedPosts();
  const classics = await getClassics();

  // Tags live on both collections, so a tag page must consider both or a term
  // only used by a deconstruction would 404.
  const labels = new Map<string, string>();
  for (const [tag] of tagCounts(posts)) labels.set(tagSlug(tag), tag);
  for (const entry of classics) {
    for (const tag of entry.data.tags) {
      if (!labels.has(tagSlug(tag))) labels.set(tagSlug(tag), tag);
    }
  }

  return [...labels.entries()].map(([slug, label]) => ({
    params: { tag: slug },
    props: {
      label,
      posts: posts.filter((p) => p.data.tags.some((t) => tagSlug(t) === slug)),
      classics: classics.filter((e) => e.data.tags.some((t) => tagSlug(t) === slug)),
    },
  }));
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { label, posts, classics } = Astro.props as Props;
---

<Base title={`标签：${label}`} description={`与 ${label} 相关的文章。`} section="archive">
  <div class="page page-wide">
    <p class="kicker">标签</p>
    <h1 class="page-title">
      {label} <span class="muted mono count">{posts.length + classics.length}</span>
    </h1>
    <div class="feed">
      {posts.map((post) => <Entry post={post} as="h3" />)}
    </div>
    <ClassicList items={classics} />
  </div>
</Base>
