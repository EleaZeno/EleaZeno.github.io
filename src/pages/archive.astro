---
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import ClassicList from '../components/ClassicList.astro';
import { getPublishedPosts, getDreams } from '../lib/posts';
import { getClassics } from '../lib/classics';
import { dreamUrl } from '../lib/url';

const posts = await getPublishedPosts();
const classics = await getClassics();
const dreams = await getDreams();

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const y = post.data.pubDate.getUTCFullYear();
  const bucket = byYear.get(y);
  if (bucket) bucket.push(post);
  else byYear.set(y, [post]);
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);

// Deconstructions are grouped separately rather than mixed into the year feed:
// they are dated by when they were written, but a reader looks for them by which
// paper they cover, not by month.
const classicsByYear = new Map<number, typeof classics>();
for (const entry of classics) {
  const y = entry.data.pubDate.getUTCFullYear();
  const bucket = classicsByYear.get(y);
  if (bucket) bucket.push(entry);
  else classicsByYear.set(y, [entry]);
}

// Nightly notes are listed per year too. They were previously reachable only
// from their own page, so an archive claiming to hold everything silently
// omitted them.
const dreamsByYear = new Map<number, typeof dreams>();
for (const entry of dreams) {
  const y = entry.data.date.getUTCFullYear();
  const bucket = dreamsByYear.get(y);
  if (bucket) bucket.push(entry);
  else dreamsByYear.set(y, [entry]);
}

const allYears = [
  ...new Set([...years.map(([y]) => y), ...dreamsByYear.keys(), ...classicsByYear.keys()]),
].sort((a, b) => b - a);
---

<Base title="归档" description="全部文章按年份排列。" section="archive">
  <div class="page page-wide">
    <p class="kicker">归档</p>
    <h1 class="page-title">
      共 {posts.length} 篇文章{classics.length > 0 && <> · {classics.length} 篇一手文献</>}{
        dreams.length > 0 && <> · {dreams.length} 篇夜间笔记</>
      }
    </h1>
    {
      allYears.map((year) => (
        <section class="year-group">
          <p class="year-label">{year}</p>
          <div class="feed">
            {(byYear.get(year) ?? []).map((post) => <Entry post={post} as="h3" />)}
          </div>
          <ClassicList items={classicsByYear.get(year) ?? []} heading="本年的一手文献" />
          {(dreamsByYear.get(year) ?? []).length > 0 && (
            <section class="classic-aside">
              <p class="kicker">本年的夜间笔记</p>
              <ul class="classic-list">
                {(dreamsByYear.get(year) ?? []).map((d) => (
                  <li>
                    <a href={dreamUrl(d.id)}>{d.data.title}</a>
                    <span class="muted mono"> {d.id}</span>
                    <p class="muted row-note">
                      {d.data.summary}
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </section>
      ))
    }
    {
      posts.length === 0 && classics.length === 0 && dreams.length === 0 && (
        <p class="empty">还没有文章。</p>
      )
    }
  </div>
</Base>
