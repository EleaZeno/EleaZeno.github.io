---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import { getPublishedPosts, formatDate } from '../lib/posts';
import { postUrl } from '../lib/url';

const recent = (await getPublishedPosts()).slice(0, 3);
---

<Base title="页面不存在" description="这个地址没有对应的页面。">
  <div class="notfound">
    <p class="mono muted">404</p>
    <h1>这里没有东西</h1>
    <p class="standfirst">
      地址写错了，或者这篇内容已经改过路径。下面是最近几篇，也可以回<a href={url('')}>首页</a>或翻<a href={url('archive')}>归档</a>。
    </p>

    <ul class="plain">
      {
        recent.map((p) => (
          <li>
            <a href={postUrl(p.id)}>{p.data.title}</a>
            <span class="muted mono"> · {formatDate(p.data.pubDate)}</span>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
