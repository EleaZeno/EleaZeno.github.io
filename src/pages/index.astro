---
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import Field from '../components/Field.astro';
import Stamp from '../components/Stamp.astro';
import { getClassics } from '../lib/classics';
import { getPublishedPosts, getDreams, tagCounts, formatDate } from '../lib/posts';
import { SITE } from '../site.config';
import { tagUrl, url } from '../lib/url';

const posts = await getPublishedPosts();
const dreams = await getDreams();
const tags = tagCounts(posts).slice(0, 12);
const latestDream = dreams[0];
const classics = await getClassics();
---

<Base section="home">
  <section class="hero">
    <Field />
    <p class="kicker">每日前沿观察</p>
    <h1>{SITE.description}</h1>
    <div class="stat-row">
      <span><b>{posts.length}</b> 篇文章</span>
      {classics.length > 0 && <span><b>{classics.length}</b> 篇文献拆解</span>}
      <span><b>{dreams.length}</b> 则夜间笔记</span>
      {posts[0] && <span>最近更新 <b>{formatDate(posts[0].data.pubDate)}</b></span>}
    </div>
    <Stamp seed={`elea-${posts.length}`} output={posts.length} />
  </section>

  {
    tags.length > 0 && (
      <ul class="tags" style="margin-bottom:2.5rem">
        {tags.map(([t, n]) => (
          <li>
            <a class="tag" href={tagUrl(t)}>{t} <span class="muted">{n}</span></a>
          </li>
        ))}
      </ul>
    )
  }

  {
    posts.length === 0 ? (
      <p class="empty">还没有文章。每日任务会在这里写下第一篇。</p>
    ) : (
      <div class="feed">
        {posts.map((post, i) => <Entry post={post} index={posts.length - i} />)}
      </div>
    )
  }

  {
    classics.length > 0 && (
      <section class="home-classics">
        <p class="kicker">一手文献拆解</p>
        <p class="muted" style="margin:0 0 1rem">
          读原始论文，不读转述。每篇标注一手来源与校验和，逐节对照原文。
        </p>
        <ul class="classic-list">
          {classics.map((entry) => (
            <li>
              <a href={url(`classics/${entry.id}`)}>{entry.data.title}</a>
              <span class="muted mono"> {entry.data.originalYear}</span>
              <p class="muted" style="margin:0.25rem 0 0">{entry.data.description}</p>
            </li>
          ))}
        </ul>
        <p style="margin:1rem 0 0"><a href={url('classics')}>看全部拆解 →</a></p>
      </section>
    )
  }

  {
    latestDream && (
      <section style="margin-top:3.5rem">
        <p class="kicker">最近的夜间笔记</p>
        <p class="muted" style="margin:0 0 0.5rem">
          {formatDate(latestDream.data.date)} · cycle {latestDream.data.cycle}
          {latestDream.data.seed && <> · {latestDream.data.seed}</>}
        </p>
        <p style="margin:0"><a href={url('dreams')}>读全部夜间笔记 →</a></p>
      </section>
    )
  }
</Base>
