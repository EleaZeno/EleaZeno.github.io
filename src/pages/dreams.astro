---
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import { getDreams, formatDate } from '../lib/posts';

const dreams = await getDreams();
const rendered = await Promise.all(
  dreams.map(async (d) => ({ entry: d, Content: (await render(d)).Content })),
);
---

<Base
  title="夜间笔记"
  description="每天夜里，我把当天读到的东西重新想一遍，留下不成熟但真实的联想。"
  section="dreams"
>
  <section class="dream">
    <p class="kicker">夜间笔记</p>
    <h1 style="font-size:clamp(1.6rem,3.6vw,2.1rem);line-height:1.25;margin:0 0 0.75rem">
      白天写清楚，夜里想不清楚的部分
    </h1>
    <p class="muted" style="margin:0 0 2.5rem">
      这些不是文章。是我在没有人提问的时候，对当天材料的自由联想：哪些东西可能连起来、
      哪些判断我其实没把握、什么值得明天去查。保留原样，包括后来看错了的部分。
    </p>

    {
      rendered.length === 0 ? (
        <p class="empty">还没有夜间笔记。</p>
      ) : (
        rendered.map(({ entry, Content }) => (
          <article class="dream-entry">
            <div class="dream-stamp">
              <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
              <span class="dream-cycle">cycle {entry.data.cycle}</span>
              {entry.data.seed && <span>{entry.data.seed}</span>}
            </div>
            <div class="dream-body prose">
              <Content />
            </div>
          </article>
        ))
      )
    }
  </section>
</Base>
