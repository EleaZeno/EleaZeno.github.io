---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Stamp from '../../components/Stamp.astro';
import { getConcepts, conceptGraph, LEVEL_LABELS } from '../../lib/wiki';
import { DOMAIN_LABELS, formatDate } from '../../lib/posts';
import { url, postUrl } from '../../lib/url';
import { hasSidenotes } from '../../lib/sidenotes';

export async function getStaticPaths() {
  const concepts = await getConcepts();
  const graph = await conceptGraph();
  return concepts.map((c) => ({
    params: { id: c.id },
    props: { concept: c, node: graph.get(c.id) },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { concept, node } = Astro.props as Props;
const { Content } = await render(concept);
const marginNotes = hasSidenotes(concept.body);
const d = concept.data;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTerm',
  name: d.title,
  description: d.oneLiner,
  inDefinedTermSet: new URL(url('concepts'), Astro.site).toString(),
};
---

<Base title={d.title} description={d.oneLiner} section="concepts">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <div class:list={['layout', marginNotes && 'has-margin-notes']}>
    <article class="article concept">
      <header class="article-head">
        <p class="kicker">词条 · {DOMAIN_LABELS[d.domain] ?? d.domain} · {LEVEL_LABELS[d.level]}</p>
        <h1>{d.title}</h1>
        <p class="standfirst">{d.oneLiner}</p>
        {d.aliases.length > 0 && (
          <p class="muted mono aliases">也称：{d.aliases.join('、')}</p>
        )}
      </header>

      {node && node.path.length > 0 && (
        <nav class="prereq-path" aria-label="前置阅读顺序">
          <p class="prereq-path-label">
            先读这些（{node.path.length} 条，按顺序）
          </p>
          <ol class="prereq-path-list">
            {node.path.map((p) => (
              <li>
                <a href={url('concepts/' + p.id)}>{p.data.title}</a>
                <span class="prereq-path-hint">{p.data.oneLiner}</span>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="prose">
        <Content />
      </div>

      {d.sources.length > 0 && (
        <section class="sources">
          <h2>来源</h2>
          <ol>
            {d.sources.map((s: { title: string; url: string; outlet?: string }) => (
              <li>
                <a href={s.url} rel="nofollow noopener" target="_blank">{s.title}</a>
                {s.outlet && <span class="muted"> · {s.outlet}</span>}
              </li>
            ))}
          </ol>
        </section>
      )}

      {node && node.mentionedBy.length > 0 && (
        <section class="backlinks">
          <h2>提到这个词条的文章</h2>
          <ul>
            {node.mentionedBy.map((m) => (
              <li>
                <a href={m.kind === 'classic' ? url('classics/' + m.id) : postUrl(m.id)}>
                  {m.title}
                </a>
                {m.kind === 'classic' && <span class="badge-classic">经典</span>}
                <span class="muted mono"> {formatDate(m.date)}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>

    <div class="rail-stack">
      {node && node.related.length > 0 && (
        <nav class="rail" aria-label="相关词条">
          <p class="rail-label">相关词条</p>
          <ul class="rail-list">
            {node.related.map((r) => (
              <li>
                <a href={url('concepts/' + r.id)}>{r.data.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      {node && node.unlocks.length > 0 && (
        <nav class="rail" aria-label="读完可以继续">
          <p class="rail-label">读完这条可以看</p>
          <ul class="rail-list">
            {node.unlocks.map((u) => (
              <li>
                <a href={url('concepts/' + u.id)}>{u.data.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      <Stamp seed={concept.id} />
    </div>
  </div>
</Base>
