---
import type { InferGetStaticPropsType } from 'astro';
import Base from '../../layouts/Base.astro';
import Entry from '../../components/Entry.astro';
import ClassicList from '../../components/ClassicList.astro';
import { getClassics } from '../../lib/classics';
import { getPublishedPosts, DOMAIN_LABELS } from '../../lib/posts';

export const getStaticPaths = async () => {
  const posts = await getPublishedPosts();
  const classics = await getClassics();

  // Classics carry `field` with the same vocabulary as a post's `domain`, so a
  // domain page should surface both kinds of writing on that subject.
  const domains = [
    ...new Set([...posts.map((p) => p.data.domain), ...classics.map((e) => e.data.field)]),
  ];

  return domains.map((domain) => ({
    params: { domain },
    props: {
      domain,
      posts: posts.filter((p) => p.data.domain === domain),
      classics: classics.filter((e) => e.data.field === domain),
    },
  }));
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { domain, posts, classics } = Astro.props as Props;
const label = DOMAIN_LABELS[domain] ?? domain;
---

<Base title={label} description={`${label} 相关的全部文章。`}>
  <header class="page">
    <p class="kicker">领域</p>
    <h1>{label}</h1>
    <p class="muted mono">{posts.length + classics.length} 篇</p>
  </header>

  <div class="feed">
    {posts.map((post) => <Entry post={post} as="h2" />)}
  </div>
  <ClassicList items={classics} />
</Base>
